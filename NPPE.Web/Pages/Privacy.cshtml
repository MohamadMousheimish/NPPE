@page
@model PrivacyModel
@{
    ViewData["Title"] = SharedLocalizer["Privacy"].Value;
}

<style>
    .prose { max-width: 68ch; }
    .prose h2 { font-size: 1.2rem; margin: 2rem 0 0.6rem; }
    .prose p { color: var(--slate); margin-bottom: 0.8rem; }
</style>

<div class="phead" data-reveal>
    <div><span class="eyebrow eyebrow--signal">@SharedLocalizer["Legal"]</span><h1>@Html.Raw(SharedLocalizer["Privacy <em>policy</em>"])</h1><p class="sub">@SharedLocalizer["How NPPE Prep handles your data."]</p></div>
</div>

<div class="prose" data-reveal>
    <p>@SharedLocalizer["This page explains what data NPPE Prep collects, why, and how you control it."]</p>

    <h2>@SharedLocalizer["What we collect"]</h2>
    <p>@SharedLocalizer["Your account details (name, email), your exam attempts and scores, and payment records processed securely through Stripe. We never store your card details on our servers."]</p>

    <h2>@SharedLocalizer["How we use it"]</h2>
    <p>@SharedLocalizer["To run your account, show your progress and history, process payments, and improve the practice material. We do not sell your data."]</p>

    <h2>@SharedLocalizer["Your controls"]</h2>
    <p>@SharedLocalizer["You can view and update your profile at any time, or request deletion of your account. Reach us through the contact link in the footer."]</p>

    <h2>@SharedLocalizer["Cookies"]</h2>
    <p>@SharedLocalizer["We use only the cookies needed to keep you signed in and remember your language preference."]</p>
</div>

<a class="backlink" asp-page="/Index">&larr; @SharedLocalizer["Back to dashboard"]</a>
