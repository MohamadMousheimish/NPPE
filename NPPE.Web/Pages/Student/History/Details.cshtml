@page
@model NPPE.Web.Pages.Student.History.DetailsModel
@{
    ViewData["Title"] = SharedLocalizer["Exam review"].Value;
    ViewData["ActiveNav"] = "history";
    var a = Model.Attempt!;
    var pct = a.TotalQuestions > 0 ? (int)Math.Round(a.Score * 100.0 / a.TotalQuestions) : 0;
    var pass = pct >= 65;
    var incorrect = a.TotalQuestions - a.Score;
}

<span class="eyebrow eyebrow--signal" data-reveal>@a.ExamTitle · @SharedLocalizer["Attempt"]</span>

<section class="result-hero @(pass ? "pass" : "fail")" data-animate data-reveal style="margin-top:1rem">
    <div class="result-ring @(pass ? "pass" : "fail")">
        <svg viewBox="0 0 148 148"><circle class="track" cx="74" cy="74" r="66"></circle><circle class="fill" cx="74" cy="74" r="66" data-pct="@pct" data-circ="414.7"></circle></svg>
        <div class="ctr"><div class="pct">@pct%</div><div class="lb">@SharedLocalizer["Score"]</div></div>
    </div>
    <div class="result-verdict @(pass ? "pass" : "fail")">
        <span class="eyebrow @(pass ? "eyebrow--signal" : "")">@(pass ? SharedLocalizer["Passed"] : SharedLocalizer["Below the 65% line"])</span>
        <h1>@a.Score <em>/ @a.TotalQuestions @SharedLocalizer["Correct"]</em></h1>
        <p>@SharedLocalizer["A full record of this attempt — your answer, the correct answer, and the reasoning for every question."]</p>
        <div class="result-stats">
            <div class="st"><div class="v" style="color:var(--pass)">@a.Score</div><div class="k">@SharedLocalizer["Correct"]</div></div>
            <div class="st"><div class="v" style="color:var(--fail)">@incorrect</div><div class="k">@SharedLocalizer["Incorrect"]</div></div>
            <div class="st"><div class="v">@pct%</div><div class="k">@SharedLocalizer["Pass line 65%"]</div></div>
        </div>
    </div>
</section>

<div class="sec-head" data-reveal>
    <div><span class="eyebrow eyebrow--signal">@SharedLocalizer["Full review"]</span><h2>@SharedLocalizer["Every question"]</h2></div>
</div>

@foreach (var q in a.Questions)
{
    <div class="review-item @(q.IsCorrect ? "ok" : "no")" data-reveal>
        <div class="review-item__head">
            <span class="rtick">
                @if (q.IsCorrect)
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12.5l4 4 10-10"/></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M6 6l12 12M18 6L6 18"/></svg>
                }
            </span>
            <div><h3>@q.QuestionText</h3></div>
        </div>
        <div class="ans @(q.IsCorrect ? "mine-ok" : "mine-no")"><span class="al">@q.SelectedLabel</span> @SharedLocalizer["Your answer —"] @q.SelectedText</div>
        @if (!q.IsCorrect)
        {
            <div class="ans correct"><span class="al">@q.CorrectLabel</span> @SharedLocalizer["Correct answer —"] @q.CorrectText</div>
        }
        <div class="explain" style="white-space:pre-line">@q.FeedbackMessage</div>
    </div>
}

<div class="take-submit" data-reveal style="margin-top:1.6rem">
    <div><b>@SharedLocalizer["Try for a higher score?"]</b><p>@SharedLocalizer["Retake this module or head back to your full history."]</p></div>
    <div style="display:flex; gap:0.7rem">
        <a class="btn btn--ghost" asp-page="Index">@SharedLocalizer["Back to history"]</a>
        <a class="btn btn--primary" asp-page="/Student/Exams/Take" asp-route-id="@a.ExamId">@SharedLocalizer["Retake"] <span class="arrow">&rarr;</span></a>
    </div>
</div>
