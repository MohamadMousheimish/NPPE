@page
@model NPPE.Web.Pages.Student.Exams.TakeModel
@{
    ViewData["Title"] = Model.Exam?.Title ?? SharedLocalizer["Take exam"].Value;
    ViewData["ActiveNav"] = "exams";
    var exam = Model.Exam!;
    var total = exam.Questions.Count;
}

<div class="take-head">
    <div class="take-head__in">
        <div class="meta">
            <span class="eyebrow">@SharedLocalizer["In progress"]</span>
            <h1>@exam.Title</h1>
        </div>
        <div class="take-gauge">
            <div class="big"><span id="answered">0</span>/<span id="total">@total</span></div>
            <div class="lbl" style="text-transform:uppercase">@SharedLocalizer["Answered"]</div>
        </div>
    </div>
    <div class="take-progress"><i id="bar"></i></div>
</div>

<form method="post" class="take-body" id="exam">
    <input asp-for="ExamId" type="hidden" />

    <div asp-validation-summary="All" style="margin-bottom:1.2rem"></div>

    @for (int qi = 0; qi < total; qi++)
    {
        var q = exam.Questions[qi];
        <div class="q-card">
            <div class="q-card__head">
                <span class="q-num">@((qi + 1).ToString("D2"))</span>
                <span class="of">@SharedLocalizer["Question"] @(qi + 1) @SharedLocalizer["of"] @total</span>
                <span class="q-status"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/></svg> @SharedLocalizer["Not answered"]</span>
            </div>
            <div class="q-card__body">
                <p class="q-text">@q.Text</p>
                @foreach (var option in q.Options)
                {
                    <label class="opt">
                        <input type="radio" name="Answers[@q.Id]" value="@option.Id" required />
                        <span class="lab">@option.Label</span>
                        <span class="txt">@option.Text</span>
                    </label>
                }
            </div>
        </div>
    }

    <div class="take-submit">
        <div>
            <b>@SharedLocalizer["Ready to submit?"]</b>
            <p>@SharedLocalizer["Answer every question, then submit to see your score and explanations."]</p>
        </div>
        <button class="btn btn--primary btn--lg" type="submit">@SharedLocalizer["Submit exam"] <span class="arrow">&rarr;</span></button>
    </div>

    <a class="backlink" asp-page="Index">&larr; @SharedLocalizer["Leave without submitting"]</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var form = document.getElementById("exam");
            var cards = [].slice.call(form.querySelectorAll(".q-card"));
            var total = cards.length;
            var answeredEl = document.getElementById("answered");
            var bar = document.getElementById("bar");
            var lblAnswered = @Json.Serialize(SharedLocalizer["Answered"].Value);

            form.addEventListener("change", function (e) {
                if (e.target.type !== "radio") return;
                var card = e.target.closest(".q-card");
                var status = card.querySelector(".q-status");
                status.classList.add("done");
                status.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12.5l4 4 10-10"/></svg> ' + lblAnswered;

                var done = cards.filter(function (c) { return c.querySelector("input:checked"); }).length;
                answeredEl.textContent = done;
                bar.style.width = (done / total * 100) + "%";
            });
        })();
    </script>
}
