@page
@model NPPE.Web.Pages.Student.Exams.ResultsModel
@{
    ViewData["Title"] = SharedLocalizer["Results"].Value;
    ViewData["ActiveNav"] = "exams";
    var a = Model.Attempt!;
    var pct = a.TotalQuestions > 0 ? (int)Math.Round(a.Score * 100.0 / a.TotalQuestions) : 0;
    var pass = pct >= 65;
    var incorrect = a.TotalQuestions - a.Score;
}

<span class="eyebrow eyebrow--signal" data-reveal>@a.ExamTitle · @SharedLocalizer["Result"]</span>

<section class="result-hero @(pass ? "pass" : "fail")" data-animate data-reveal style="margin-top:1rem">
    <div class="result-ring @(pass ? "pass" : "fail")">
        <svg viewBox="0 0 148 148">
            <circle class="track" cx="74" cy="74" r="66"></circle>
            <circle class="fill" cx="74" cy="74" r="66" data-pct="@pct" data-circ="414.7"></circle>
        </svg>
        <div class="ctr"><div class="pct">@pct%</div><div class="lb">@SharedLocalizer["Score"]</div></div>
    </div>
    <div class="result-verdict @(pass ? "pass" : "fail")">
        <span class="eyebrow @(pass ? "eyebrow--signal" : "")">@(pass ? SharedLocalizer["Passed · above the 65% line"] : SharedLocalizer["Below the 65% line"])</span>
        <h1>@(pass ? SharedLocalizer["Nicely done."] : SharedLocalizer["Keep practising."]) <em>@a.Score / @a.TotalQuestions</em></h1>
        <p>@(pass ? SharedLocalizer["You cleared this module. Review anything you missed below to lock it in."] : SharedLocalizer["Close — review the explanations below and retake when you're ready."])</p>
        <div class="result-stats">
            <div class="st"><div class="v" style="color:var(--pass)">@a.Score</div><div class="k">@SharedLocalizer["Correct"]</div></div>
            <div class="st"><div class="v" style="color:var(--fail)">@incorrect</div><div class="k">@SharedLocalizer["Incorrect"]</div></div>
            <div class="st"><div class="v">@a.TotalQuestions</div><div class="k">@SharedLocalizer["Total items"]</div></div>
        </div>
    </div>
</section>

<div class="sec-head" data-reveal>
    <div><span class="eyebrow eyebrow--signal">@SharedLocalizer["Answer review"]</span><h2>@SharedLocalizer["See what you missed"]</h2></div>
</div>

@foreach (var q in a.Questions)
{
    <div class="review-item @(q.IsCorrect ? "ok" : "no")" data-reveal>
        <div class="review-item__head">
            <span class="rtick">
                @if (q.IsCorrect)
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12.5l4 4 10-10"/></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M6 6l12 12M18 6L6 18"/></svg>
                }
            </span>
            <div><h3>@q.QuestionText</h3></div>
        </div>
        <div class="ans @(q.IsCorrect ? "mine-ok" : "mine-no")"><span class="al">@q.SelectedLabel</span> @SharedLocalizer["Your answer —"] @q.SelectedText</div>
        @if (!q.IsCorrect)
        {
            <div class="ans correct"><span class="al">@q.CorrectLabel</span> @SharedLocalizer["Correct answer —"] @q.CorrectText</div>
        }
        <div class="explain" style="white-space:pre-line">@q.FeedbackMessage</div>
    </div>
}

<div class="take-submit" data-reveal style="margin-top:1.6rem">
    <div><b>@SharedLocalizer["What's next?"]</b><p>@SharedLocalizer["Retake this module to push the score higher, or move on to another."]</p></div>
    <div style="display:flex; gap:0.7rem">
        <a class="btn btn--ghost" asp-page="/Student/Exams/Index">@SharedLocalizer["All modules"]</a>
        <a class="btn btn--primary" asp-page="Take" asp-route-id="@a.ExamId">@SharedLocalizer["Retake"] <span class="arrow">&rarr;</span></a>
    </div>
</div>

<a class="backlink" asp-page="/Student/History/Index">&larr; @SharedLocalizer["View full history"]</a>
