@page
@model NPPE.Web.Pages.Student.Study.IndexModel
@{
    ViewData["Title"] = SharedLocalizer["Study Hub"].Value;
    ViewData["ActiveNav"] = "study";
}
@section Head {
    <link rel="stylesheet" href="~/css/study.css" asp-append-version="true" />
}

<div class="phead" data-reveal>
    <div>
        <span class="eyebrow eyebrow--signal">@SharedLocalizer["Prepare"]</span>
        <h1>@Html.Raw(SharedLocalizer["Study <em>hub</em>"])</h1>
        <p class="sub">@SharedLocalizer["Everything on the NPPE syllabus, organised into the six weighted sections — written to be read, not skimmed."]</p>
    </div>
    <a class="btn btn--ghost" asp-page="/Student/Exams/Index">@SharedLocalizer["Practice exams"] <span class="arrow">&rarr;</span></a>
</div>

@if (!Model.HasAccess)
{
    <div class="lockbar" data-reveal>
        <div class="lockbar__ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
        </div>
        <div class="lockbar__tx">
            <b>@SharedLocalizer["The Study Hub is part of premium access."]</b>
            <span>@SharedLocalizer["Buy an exam pack to unlock all six sections and every worked explanation."]</span>
        </div>
        <a class="btn btn--primary" asp-page="/Payments/Pricing">@SharedLocalizer["Unlock access"] <span class="arrow">&rarr;</span></a>
    </div>
}

<div class="sec-grid" data-reveal>
    @foreach (var s in Model.Sections)
    {
        <a class="sec-card @(Model.HasAccess ? "" : "is-locked")"
           href="@(Model.HasAccess ? Url.Page("Section", new { n = s.Number }) : Url.Page("/Payments/Pricing"))">
            <div class="sec-card__top">
                <span class="sec-card__num">@s.Roman</span>
                <span class="sec-card__weight">@s.WeightPercent% · @s.QuestionRange</span>
                @if (!Model.HasAccess)
                {
                    <span class="sec-card__lock"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
                }
            </div>
            <h3>@SharedLocalizer[s.Title]</h3>
            <p class="sec-card__sum">@SharedLocalizer[s.Summary]</p>
            <ul class="sec-card__topics">
                @foreach (var t in s.Topics)
                {
                    <li>@SharedLocalizer[t]</li>
                }
            </ul>
            <span class="sec-card__go">
                @(Model.HasAccess ? SharedLocalizer["Start reading"] : SharedLocalizer["Unlock to read"])
                <span class="arrow">&rarr;</span>
            </span>
            <div class="sec-card__meter"><i style="width:@(s.WeightPercent)%"></i></div>
        </a>
    }
</div>

<div class="study-foot" data-reveal>
    <span class="eyebrow">@SharedLocalizer["The exam"]</span>
    <p>@SharedLocalizer["The NPPE is a 2½-hour, closed-book exam of 110 multiple-choice questions. It confirms your knowledge of professionalism, ethics, and law — the judgment behind the P.Eng. and P.Geo. designations."]</p>
</div>
