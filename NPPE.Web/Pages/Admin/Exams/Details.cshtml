@page
@model NPPE.Web.Pages.Admin.Exams.DetailsModel
@{
    ViewData["Title"] = "Exam details";
    ViewData["ActiveNav"] = "admin";
    var exam = Model.Exam!;
}

<div class="phead" data-reveal>
    <div>
        <span class="eyebrow eyebrow--signal">Exam · <span class="state-tag @(exam.IsActive ? "on" : "off")">@(exam.IsActive ? "Active" : "Inactive")</span></span>
        <h1>@exam.Title</h1>
        <p class="sub">@exam.Description</p>
    </div>
    <div style="display:flex; gap:0.6rem; flex-wrap:wrap">
        <a class="btn btn--primary" asp-page="/Admin/Exams/Questions/Create" asp-route-examId="@exam.Id">Add question <span class="arrow">&rarr;</span></a>
        <a class="btn btn--ghost" asp-page="Edit" asp-route-id="@exam.Id">Edit exam</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert--ok" data-reveal>@TempData["SuccessMessage"]</div>
}

<div class="sec-head" data-reveal><div><span class="eyebrow eyebrow--signal">Questions</span><h2>@Model.Questions.Count item@(Model.Questions.Count == 1 ? "" : "s")</h2></div></div>

@if (Model.Questions.Any())
{
    <div style="display:grid; gap:1rem">
        @{ var qn = 0; }
        @foreach (var q in Model.Questions)
        {
            qn++;
            <div class="q-card" data-reveal>
                <div class="q-card__head">
                    <span class="q-num">@qn.ToString("D2")</span><span class="of">Question @qn</span>
                    <div class="acts" style="margin-left:auto; display:flex; gap:0.4rem">
                        <a class="pill" asp-page="/Admin/Exams/Questions/Edit" asp-route-id="@q.Id">Edit</a>
                        <a class="pill danger" asp-page="/Admin/Exams/Questions/Delete" asp-route-id="@q.Id" asp-route-examId="@exam.Id">Delete</a>
                    </div>
                </div>
                <div class="q-card__body">
                    <p class="q-text" style="font-size:1rem">@q.Text</p>
                    <div style="display:grid; gap:0.4rem">
                        @foreach (var opt in q.Options)
                        {
                            <div class="ans @(opt.IsCorrect ? "correct" : "")">
                                <span class="al">@opt.Label</span> @opt.Text
                                @if (opt.IsCorrect)
                                {
                                    <span style="margin-left:auto; font-family:var(--font-mono); font-size:0.66rem; color:var(--pass)">CORRECT</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty" data-reveal>
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M8 10h8M8 14h5"/><rect x="4" y="4" width="16" height="16" rx="2"/></svg></div>
        <h3>No questions yet</h3>
        <p>Add the first question to this module.</p>
        <a class="btn btn--primary" asp-page="/Admin/Exams/Questions/Create" asp-route-examId="@exam.Id">Add question <span class="arrow">&rarr;</span></a>
    </div>
}

<a class="backlink" asp-page="Index">&larr; Back to library</a>
