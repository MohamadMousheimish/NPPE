@page
@model NPPE.Web.Pages.Admin.Exams.IndexModel
@{
    ViewData["Title"] = SharedLocalizer["Manage Exams"].Value;
    ViewData["ActiveNav"] = "admin";
}

<div class="phead" data-reveal>
    <div>
        <span class="eyebrow eyebrow--signal">@SharedLocalizer["Admin · Library"]</span>
        <h1>@Html.Raw(SharedLocalizer["Manage <em>exams</em>"])</h1>
        <p class="sub">@SharedLocalizer["Create, edit, and organise the modules students practise with."]</p>
    </div>
    <a class="btn btn--primary" asp-page="/Admin/Exams/Create">@SharedLocalizer["New exam"] <span class="arrow">&rarr;</span></a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert--ok" data-reveal>@SharedLocalizer[TempData["SuccessMessage"]!.ToString()!]</div>
}

@if (Model.Exams.Any())
{
    <div class="adm-list" data-reveal>
        @{ var n = 0; }
        @foreach (var exam in Model.Exams)
        {
            n++;
            <div class="adm-row">
                <span class="q-num">@n.ToString("D2")</span>
                <div>
                    <div class="code">EXAM</div>
                    <h3>@exam.Title</h3>
                </div>
                <span class="grow"></span>
                <span class="anno">@exam.CreatedAt.ToString("dd MMM yyyy")</span>
                <span class="state-tag @(exam.IsActive ? "on" : "off")">@(exam.IsActive ? SharedLocalizer["Active"] : SharedLocalizer["Inactive"])</span>
                <div class="acts">
                    <a class="pill" asp-page="Details" asp-route-id="@exam.Id">@SharedLocalizer["Open"]</a>
                    <a class="pill" asp-page="Edit" asp-route-id="@exam.Id">@SharedLocalizer["Edit"]</a>
                    <a class="pill danger" asp-page="Delete" asp-route-id="@exam.Id">@SharedLocalizer["Delete"]</a>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty" data-reveal>
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 4h11l3 3v13H5z"/><path d="M8 9h8M8 13h8M8 17h5"/></svg></div>
        <h3>@SharedLocalizer["No exams yet"]</h3>
        <p>@SharedLocalizer["Create your first module to get students practising."]</p>
        <a class="btn btn--primary" asp-page="/Admin/Exams/Create">@SharedLocalizer["New exam"] <span class="arrow">&rarr;</span></a>
    </div>
}

<a class="backlink" asp-page="/Index">&larr; @SharedLocalizer["Back to dashboard"]</a>
