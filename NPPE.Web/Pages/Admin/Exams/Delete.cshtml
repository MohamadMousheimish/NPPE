@page
@model NPPE.Web.Pages.Admin.Exams.DeleteModel
@{
    ViewData["Title"] = SharedLocalizer["Delete exam"].Value;
    ViewData["ActiveNav"] = "admin";
}

<div class="phead" data-reveal>
    <div>
        <span class="eyebrow eyebrow--signal">@SharedLocalizer["Admin · Confirm"]</span>
        <h1>@Html.Raw(SharedLocalizer["Delete <em>exam</em>"])</h1>
    </div>
</div>

<div class="confirm-card" data-reveal>
    <div class="warn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg></div>
    <h2 style="font-size:1.3rem; margin-bottom:0.5rem">@SharedLocalizer["Deactivate this exam?"]</h2>
    <p class="muted">@SharedLocalizer["You're about to deactivate"] <strong style="color:var(--ink)">@Model.ExamTitle</strong>. @SharedLocalizer["It will be hidden from students, but existing attempt history is kept intact — this is a soft delete and can be reversed by re-activating it."]</p>
    <form method="post" class="form-actions">
        <input type="hidden" asp-for="Id" />
        <button class="btn btn--danger" type="submit">@SharedLocalizer["Yes, deactivate"]</button>
        <a class="btn btn--ghost" asp-page="Details" asp-route-id="@Model.Id">@SharedLocalizer["Cancel"]</a>
    </form>
</div>

<a class="backlink" asp-page="Index">&larr; @SharedLocalizer["Back to library"]</a>
