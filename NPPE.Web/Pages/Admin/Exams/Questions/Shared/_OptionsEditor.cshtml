<div id="options-container" class="opt-editor">
    @for (int i = 0; i < 4; i++)
    {
        var label = (char)('A' + i);
        var option = i < Model.Input.Options.Count ? Model.Input.Options[i] : new NPPE.Web.Pages.Admin.Exams.Questions.CreateModel.OptionInput();

        <div class="opt-edit @(option.IsCorrect ? "correct" : "")">
            <div class="opt-edit__top">
                <span class="lab">@label</span>
                <label class="check">
                    <input type="checkbox" name="Input.Options[@i].IsCorrect" value="true"
                           @(option.IsCorrect ? "checked" : "") onchange="handleCorrectChange(this)" />
                    <span class="box"></span> Correct
                </label>
                <input type="hidden" name="Input.Options[@i].IsCorrect" value="false" />
            </div>
            <input type="hidden" name="Input.Options[@i].Id" value="@(option.Id?.ToString() ?? "")" />
            <span class="field__wrap">
                <textarea class="field__input" name="Input.Options[@i].Text" rows="2" placeholder="Option @label">@option.Text</textarea>
            </span>
            @{
                var errorMessage = ViewData.ModelState.TryGetValue($"Input.Options[{i}].Text", out var entry) && entry.Errors.Count > 0
                    ? entry.Errors[0].ErrorMessage
                    : null;
            }
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <span class="field-validation-error">@errorMessage</span>
            }
        </div>
    }
</div>

<script>
    function handleCorrectChange(checkbox) {
        if (checkbox.checked) {
            document.querySelectorAll('input[name$=".IsCorrect"][value="true"]').forEach(function (cb) {
                if (cb !== checkbox) cb.checked = false;
            });
        } else {
            var checkedCount = document.querySelectorAll('input[name$=".IsCorrect"][value="true"]:checked').length;
            if (checkedCount === 0) checkbox.checked = true;
        }
        document.querySelectorAll('#options-container .opt-edit').forEach(function (card) {
            var cb = card.querySelector('input[name$=".IsCorrect"][value="true"]');
            card.classList.toggle('correct', !!(cb && cb.checked));
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        var checkboxes = document.querySelectorAll('input[name$=".IsCorrect"][value="true"]');
        if (checkboxes.length > 0 && !Array.from(checkboxes).some(function (cb) { return cb.checked; })) {
            checkboxes[0].checked = true;
        }
        document.querySelectorAll('#options-container .opt-edit').forEach(function (card) {
            var cb = card.querySelector('input[name$=".IsCorrect"][value="true"]');
            card.classList.toggle('correct', !!(cb && cb.checked));
        });
    });
</script>
