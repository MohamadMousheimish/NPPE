@page
@model NPPE.Web.Pages.Admin.Exams.EditModel
@{
    ViewData["Title"] = SharedLocalizer["Edit exam"].Value;
    ViewData["ActiveNav"] = "admin";
}

<div class="phead" data-reveal>
    <div>
        <span class="eyebrow eyebrow--signal">@SharedLocalizer["Admin · Edit"]</span>
        <h1>@Html.Raw(SharedLocalizer["Edit <em>exam</em>"])</h1>
    </div>
</div>

<div class="form-card" data-reveal>
    <form method="post">
        <input asp-for="Input.Id" type="hidden" />
        <div asp-validation-summary="All"></div>

        <label class="field">
            <span class="field__label">@SharedLocalizer["Title"] <span class="idx">01</span></span>
            <span class="field__wrap"><input asp-for="Input.Title" class="field__input" /></span>
            <span asp-validation-for="Input.Title" class="field-validation-error"></span>
        </label>

        <label class="field">
            <span class="field__label">@SharedLocalizer["Description"] <span class="idx">02</span></span>
            <span class="field__wrap"><textarea asp-for="Input.Description" class="field__input"></textarea></span>
            <span asp-validation-for="Input.Description" class="field-validation-error"></span>
        </label>

        <label class="check" style="margin-top:0.4rem"><input asp-for="Input.IsActive" /><span class="box"></span> @SharedLocalizer["Active — visible to students"]</label>

        <div class="form-actions">
            <button class="btn btn--primary" type="submit">@SharedLocalizer["Save changes"] <span class="arrow">&rarr;</span></button>
            <a class="btn btn--ghost" asp-page="Details" asp-route-id="@Model.Input.Id">@SharedLocalizer["Cancel"]</a>
        </div>
    </form>
</div>

<a class="backlink" asp-page="Index">&larr; @SharedLocalizer["Back to library"]</a>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
