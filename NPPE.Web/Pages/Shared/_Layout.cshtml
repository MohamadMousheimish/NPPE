@{
    var authed = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
    var name = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "";
    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
    var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length == 0 ? "U"
        : (parts.Length == 1 ? parts[0].Substring(0, 1) : parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpper();
    var active = ViewData["ActiveNav"] as string ?? "";
    var culture = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var path = ViewContext.HttpContext.Request.Path;
    string NavCls(string key) => active == key ? "is-active" : "";
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · NPPE Prep</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header class="appbar">
        <div class="appbar__in">
            <a class="wm" asp-page="/Index"><span class="mk">N</span><b>NPPE&nbsp;Prep</b></a>

            @if (authed)
            {
                <nav class="nav" data-nav>
                    <a asp-page="/Index" class="@NavCls("dashboard")">Dashboard</a>
                    @if (isAdmin)
                    {
                        <a asp-page="/Admin/Exams/Index" class="@NavCls("admin")">Manage Exams</a>
                    }
                    else
                    {
                        <a asp-page="/Student/Exams/Index" class="@NavCls("exams")">Practice Exams</a>
                        <a asp-page="/Student/History/Index" class="@NavCls("history")">History</a>
                        <a asp-page="/Payments/Billing" class="@NavCls("billing")">Billing</a>
                    }
                </nav>

                <div class="appbar__right">
                    <div class="lang">
                        <a href="@($"{path}?culture=en")" class="@(culture == "en" ? "on" : "")">EN</a>
                        <span class="sep">/</span>
                        <a href="@($"{path}?culture=fr")" class="@(culture == "fr" ? "on" : "")">FR</a>
                    </div>

                    <div class="profile" data-profile>
                        <span class="avatar">@initials</span>
                        <span class="who"><b>@name</b><span>@email</span></span>
                        <span class="caret"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
                        <div class="menu" data-menu>
                            <a asp-page="/Account/Profile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg> My profile</a>
                            <a asp-page="/Account/ChangePassword"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg> Change password</a>
                            <a asp-page="/Payments/Billing"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg> Billing</a>
                            <div class="sep"></div>
                            <form method="post" asp-page="/Index" asp-page-handler="Logout">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 12H3"/><path d="M9 8l-4 4 4 4"/><path d="M13 4h6v16h-6"/></svg> @SharedLocalizer["Logout"]</button>
                            </form>
                        </div>
                    </div>

                    <button class="burger" data-burger aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
                </div>
            }
            else
            {
                <div class="appbar__right">
                    <div class="lang">
                        <a href="@($"{path}?culture=en")" class="@(culture == "en" ? "on" : "")">EN</a>
                        <span class="sep">/</span>
                        <a href="@($"{path}?culture=fr")" class="@(culture == "fr" ? "on" : "")">FR</a>
                    </div>
                    <a class="btn btn--ghost" asp-page="/Account/Login" style="border-color:var(--line-dark); color:var(--paper);">Sign in</a>
                    <a class="btn btn--primary" asp-page="/Account/Register">Sign up</a>
                </div>
            }
        </div>
    </header>

    <main class="page">
        @RenderBody()
    </main>

    <footer class="appfoot">
        <div class="appfoot__in">
            <div class="wm"><span class="mk">N</span><b>NPPE&nbsp;Prep</b></div>
            <nav>
                <a href="#">About</a>
                <a asp-page="/Privacy">Privacy</a>
                <a href="#">Terms</a>
                <a href="#">Contact</a>
            </nav>
            <div class="copy">© @DateTime.Now.Year NPPE Prep — Built for engineers-in-training · Not affiliated with any regulator</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/motion.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
