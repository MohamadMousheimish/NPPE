@page
@model NPPE.Web.Pages.Payments.PricingModel
@{
    ViewData["Title"] = "Pricing";
    ViewData["ActiveNav"] = "billing";
}

<div class="phead" data-reveal style="justify-content:center; text-align:center; flex-direction:column; align-items:center">
    <div>
        <span class="eyebrow eyebrow--signal">Unlock full access</span>
        <h1>Choose your <em>plan</em></h1>
        <p class="sub" style="margin-inline:auto">One price, everything included — all modules, unlimited attempts, and every worked explanation.</p>
    </div>
</div>

<div class="plans">
    <form method="post" class="plan" data-reveal>
        <input type="hidden" name="planType" value="onetime" />
        <input type="hidden" asp-for="ReturnUrl" />
        <span class="eyebrow">One-time</span>
        <div class="price"><span class="cur">CA$</span>29</div>
        <p class="plan-sub">Pay once. Access forever.</p>
        <ul class="feat-list">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4 4 10-10"/></svg> Unlimited exam attempts</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4 4 10-10"/></svg> All practice modules</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4 4 10-10"/></svg> Worked explanations on every item</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4 4 10-10"/></svg> No subscription, no renewals</li>
        </ul>
        <button class="btn btn--ghost btn--block" type="submit">Pay CA$29 once <span class="arrow">&rarr;</span></button>
    </form>

    <form method="post" class="plan feat" data-reveal data-reveal-delay="80">
        <input type="hidden" name="planType" value="subscription" />
        <input type="hidden" asp-for="ReturnUrl" />
        <span class="badge">Most flexible</span>
        <span class="eyebrow eyebrow--signal">Monthly</span>
        <div class="price"><span class="cur">CA$</span>9.99<small>/mo</small></div>
        <p class="plan-sub">Cancel anytime, keep access to period end.</p>
        <ul class="feat-list">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4 4 10-10"/></svg> Unlimited exam attempts</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4 4 10-10"/></svg> All practice modules</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4 4 10-10"/></svg> Worked explanations on every item</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4 4 10-10"/></svg> Cancel in one click, anytime</li>
        </ul>
        <button class="btn btn--primary btn--block" type="submit">Subscribe for CA$9.99/mo <span class="arrow">&rarr;</span></button>
    </form>
</div>

<p class="anno" style="text-align:center; margin-top:1.6rem">Secure checkout by Stripe · Cancel or refund per our terms</p>
<div style="text-align:center"><a class="backlink" asp-page="/Student/Exams/Index">&larr; Back to exams</a></div>
