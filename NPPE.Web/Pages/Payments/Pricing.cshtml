@page
@model NPPE.Web.Pages.Payments.PricingModel
@{
    ViewData["Title"] = "Choose Your Plan";
}

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12 px-4 sm:px-6 lg:px-8 -mx-4 sm:-mx-6 lg:-mx-8 -my-8">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-10">
            <h1 class="text-3xl font-bold text-gray-900">Choose Your Plan</h1>
            <p class="mt-3 text-lg text-gray-600">Get unlimited access to all NPPE exam prep materials</p>
        </div>

        <!-- Pricing Cards -->
        <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
            <!-- One-Time Payment Card -->
            <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-gray-200 flex flex-col">
                <div class="px-6 py-8 flex-1">
                    <h2 class="text-xl font-bold text-gray-900">Full Access</h2>
                    <p class="mt-2 text-sm text-gray-500">One-time payment, lifetime access</p>
                    <div class="mt-6">
                        <span class="text-4xl font-extrabold text-gray-900">$29</span>
                        <span class="text-base font-medium text-gray-500"> CAD</span>
                    </div>
                    <ul class="mt-6 space-y-3">
                        <li class="flex items-start">
                            <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <span class="text-sm text-gray-600">Unlimited exam attempts</span>
                        </li>
                        <li class="flex items-start">
                            <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <span class="text-sm text-gray-600">Access to all practice exams</span>
                        </li>
                        <li class="flex items-start">
                            <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <span class="text-sm text-gray-600">Detailed answer explanations</span>
                        </li>
                        <li class="flex items-start">
                            <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <span class="text-sm text-gray-600">Pay once, access forever</span>
                        </li>
                    </ul>
                </div>
                <div class="px-6 pb-8">
                    <form method="post">
                        <input type="hidden" name="planType" value="onetime" />
                        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                        <button type="submit"
                                class="w-full py-3 px-4 border-2 border-blue-600 text-blue-600 font-semibold rounded-xl hover:bg-blue-50 transition duration-200">
                            Pay $29 Once
                        </button>
                    </form>
                </div>
            </div>

            <!-- Monthly Subscription Card -->
            <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-blue-600 relative flex flex-col">
                <div class="absolute top-0 right-0 bg-blue-600 text-white text-xs font-bold px-3 py-1 rounded-bl-lg">
                    POPULAR
                </div>
                <div class="px-6 py-8 flex-1">
                    <h2 class="text-xl font-bold text-gray-900">Monthly</h2>
                    <p class="mt-2 text-sm text-gray-500">Flexible monthly subscription</p>
                    <div class="mt-6">
                        <span class="text-4xl font-extrabold text-gray-900">$9.99</span>
                        <span class="text-base font-medium text-gray-500"> CAD/mo</span>
                    </div>
                    <ul class="mt-6 space-y-3">
                        <li class="flex items-start">
                            <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <span class="text-sm text-gray-600">Unlimited exam attempts</span>
                        </li>
                        <li class="flex items-start">
                            <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <span class="text-sm text-gray-600">Access to all practice exams</span>
                        </li>
                        <li class="flex items-start">
                            <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <span class="text-sm text-gray-600">Detailed answer explanations</span>
                        </li>
                        <li class="flex items-start">
                            <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <span class="text-sm text-gray-600">Cancel anytime</span>
                        </li>
                    </ul>
                </div>
                <div class="px-6 pb-8">
                    <form method="post">
                        <input type="hidden" name="planType" value="subscription" />
                        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                        <button type="submit"
                                class="w-full py-3 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-xl shadow-lg hover:from-blue-700 hover:to-indigo-700 transition duration-200">
                            Subscribe for $9.99/mo
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Back Link -->
        <div class="mt-10 text-center">
            <a asp-page="/Student/Exams/Index" class="inline-flex items-center text-gray-600 hover:text-blue-600 transition duration-200">
                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5M12 19l-7-7 7-7" />
                </svg>
                Back to Exams
            </a>
        </div>
    </div>
</div>
