@page
@model NPPE.Web.Pages.Payments.HistoryModel
@{
    ViewData["Title"] = "Payment History";
}

<div class="max-w-4xl mx-auto">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Payment History</h1>
        <p class="text-gray-600">View all your past transactions.</p>
    </div>

    @if (Model.Payments.Any())
    {
        <div class="bg-white shadow overflow-hidden sm:rounded-lg">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var payment in Model.Payments)
                    {
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                @(payment.PaidAt != default ? payment.PaidAt.ToString("MMM dd, yyyy") : payment.CreatedAt.ToString("MMM dd, yyyy"))
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                                @if (payment.PaymentType == "OneTime")
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                                        One-Time
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                        Subscription
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                $@payment.Amount.ToString("F2") @payment.Currency
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                @if (payment.Status == "Succeeded")
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        Succeeded
                                    </span>
                                }
                                else if (payment.Status == "Pending")
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                        Failed
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-12 bg-white rounded-lg shadow">
            <p class="text-gray-600">No payment history found.</p>
            <a asp-page="/Payments/Pricing"
               class="mt-4 inline-block text-blue-600 hover:underline">View pricing plans</a>
        </div>
    }

    <div class="mt-6">
        <a asp-page="/Payments/Billing" class="inline-flex items-center text-gray-600 hover:text-blue-600 transition duration-200">
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            Back to Billing
        </a>
    </div>
</div>
