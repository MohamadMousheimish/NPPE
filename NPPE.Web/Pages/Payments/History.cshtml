@page
@model NPPE.Web.Pages.Payments.HistoryModel
@{
    ViewData["Title"] = "Payment history";
    ViewData["ActiveNav"] = "billing";
}

<div class="phead" data-reveal>
    <div><span class="eyebrow eyebrow--signal">Transactions</span><h1>Payment <em>history</em></h1><p class="sub">Every charge on your account.</p></div>
</div>

@if (Model.Payments.Any())
{
    <div class="tbl-wrap" data-reveal>
        <table class="tbl">
            <thead><tr><th>Date</th><th>Type</th><th>Amount</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var p in Model.Payments)
                {
                    var statusClass = p.Status == "Succeeded" ? "active" : (p.Status == "Failed" ? "cancel" : "");
                    <tr>
                        <td class="mono">@((p.PaidAt == default ? p.CreatedAt : p.PaidAt).ToString("dd MMM yyyy"))</td>
                        <td><span class="tag @(p.PaymentType == "Subscription" ? "tag--signal" : "")">@p.PaymentType</span></td>
                        <td class="mono">@p.Amount.ToString("0.00") @p.Currency</td>
                        <td><span class="status-badge @statusClass">@p.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="empty" data-reveal>
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg></div>
        <h3>No payments yet</h3>
        <p>Your transactions will appear here once you subscribe or buy access.</p>
        <a class="btn btn--primary" asp-page="/Payments/Pricing">View plans <span class="arrow">&rarr;</span></a>
    </div>
}

<a class="backlink" asp-page="/Payments/Billing">&larr; Back to billing</a>
