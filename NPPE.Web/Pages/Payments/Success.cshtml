@page
@model NPPE.Web.Pages.Payments.SuccessModel
@{
    ViewData["Title"] = SharedLocalizer["Payment successful"].Value;
    ViewData["ActiveNav"] = "billing";
}

<div class="success-hero" data-reveal>
    <div class="big-ic pass"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4.5 4.5L19 7"/></svg></div>
    <span class="eyebrow eyebrow--signal" style="justify-content:center">@SharedLocalizer["Payment confirmed"]</span>
    <h1 style="margin-top:0.8rem">@SharedLocalizer["You're in."]</h1>
    <p>@SharedLocalizer["Your exam pack is unlocked — your practice exams and the full Study Hub are ready when you are."]</p>
    @if (!string.IsNullOrEmpty(Model.ReturnUrl))
    {
        <a class="btn btn--primary btn--lg" href="@Model.ReturnUrl">@SharedLocalizer["Continue"] <span class="arrow">&rarr;</span></a>
    }
    else
    {
        <a class="btn btn--primary btn--lg" asp-page="/Student/Exams/Index">@SharedLocalizer["Start practising"] <span class="arrow">&rarr;</span></a>
    }
</div>

@section Scripts {
    @if (Model.Confirmed && Model.PurchaseValue > 0)
    {
        <script>
            // GA4 / Google Ads purchase conversion (no-ops if analytics isn't loaded, e.g. dev).
            if (typeof gtag === "function") {
                gtag("event", "purchase", {
                    transaction_id: "@Model.TransactionId",
                    value: @Model.PurchaseValue.ToString(System.Globalization.CultureInfo.InvariantCulture),
                    currency: "CAD",
                    items: [{ item_name: "NPPE exam pack" }]
                });
            }
        </script>
    }
}
