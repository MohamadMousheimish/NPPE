@page
@model NPPE.Web.Pages.Payments.BillingModel
@{
    ViewData["Title"] = SharedLocalizer["Billing"].Value;
    ViewData["ActiveNav"] = "billing";
}

<div class="phead" data-reveal>
    <div><span class="eyebrow eyebrow--signal">@SharedLocalizer["Your access"]</span><h1>@Html.Raw(SharedLocalizer["Access &amp; <em>attempts</em>"])</h1><p class="sub">@SharedLocalizer["The exams you've unlocked and how many attempts remain on each."]</p></div>
</div>

@if (!Model.Exams.Any())
{
    <div class="empty" data-reveal style="max-width:620px; text-align:left">
        <div class="ic" style="margin:0 0 1.1rem"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></div>
        <h3>@SharedLocalizer["No exams unlocked yet"]</h3>
        <p>@SharedLocalizer["Buy an exam pack to unlock full practice exams and the complete Study Hub."]</p>
        <a class="btn btn--primary" asp-page="/Payments/Pricing">@SharedLocalizer["View exam packs"] <span class="arrow">&rarr;</span></a>
    </div>
}
else
{
    <div class="bill-card" data-reveal>
        <div class="bill-card__head">
            <div>
                <h2>@SharedLocalizer["{0} exams unlocked", Model.Exams.Count]</h2>
                <div class="price">@SharedLocalizer["One-time exam pack · no subscription"]</div>
            </div>
            <span class="status-badge active">@SharedLocalizer["Active"]</span>
        </div>
        <div class="bill-card__body">
            <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:.9rem">
                @foreach (var e in Model.Exams)
                {
                    <li style="display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.85rem 0; border-bottom:1px solid rgba(0,0,0,.07)">
                        <div style="display:flex; flex-direction:column; gap:.2rem">
                            <b>@e.Title</b>
                            <span class="anno">@SharedLocalizer["Unlocked {0}", e.UnlockedAt.ToString("dd MMM yyyy")]</span>
                        </div>
                        <span class="status-badge @(e.AttemptsRemaining > 0 ? "active" : "cancel")">
                            @SharedLocalizer["{0} of {1} attempts left", e.AttemptsRemaining, e.AttemptsAllowed]
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>
}

<div style="display:flex; gap:1.4rem; margin-top:1.4rem" data-reveal>
    <a class="link" asp-page="/Payments/History">@SharedLocalizer["Payment history"] &rarr;</a>
    <a class="link" asp-page="/Payments/Pricing">@SharedLocalizer["Buy another pack"] &rarr;</a>
</div>

<a class="backlink" asp-page="/Index">&larr; @SharedLocalizer["Back to dashboard"]</a>
