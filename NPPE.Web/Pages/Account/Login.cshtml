@page
@model NPPE.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = SharedLocalizer["Sign in"].Value;
    Layout = "_AuthLayout";
}

<main class="auth">
    <section class="brand panel--dark reg">
        <span class="reg-mark tl"></span><span class="reg-mark tr"></span>
        <span class="reg-mark bl"></span><span class="reg-mark br"></span>
        <div class="brand__grid grid-bg--dark"></div>

        <svg class="gauge" viewBox="0 0 128 128" aria-hidden="true">
            <circle cx="64" cy="64" r="60" stroke="var(--line-dark)" stroke-width="1"></circle>
            <circle cx="64" cy="64" r="52" stroke="var(--line-dark)" stroke-width="6" stroke-dasharray="1 7.6"></circle>
            <circle class="arc" cx="64" cy="64" r="44"></circle>
            <line x1="64" y1="18" x2="64" y2="26" stroke="var(--slate-2)" stroke-width="1"></line>
            <line x1="64" y1="102" x2="64" y2="110" stroke="var(--slate-2)" stroke-width="1"></line>
            <text class="lbl" x="64" y="63">NPPE</text>
            <text class="sub" x="64" y="76">CALIBRATED</text>
        </svg>

        <div class="wordmark">
            <span class="mark">N</span>
            <div class="stack"><b>NPPE&nbsp;Prep</b><span>@SharedLocalizer["Exam Preparation"]</span></div>
        </div>

        <div class="hero">
            <span class="eyebrow eyebrow--signal">@SharedLocalizer["Professional Practice Exam"]</span>
            <h1>@SharedLocalizer["Calibrated prep for your"] <em>P.Eng.</em></h1>
            <p>@SharedLocalizer["Timed practice modules, worked explanations, and progress you can actually measure — built for engineers-in-training."]</p>
        </div>

        <div class="titleblock">
            <div class="row">
                <div class="cell"><span class="k">@SharedLocalizer["Drawing"]</span><span class="v">NPPE-PREP</span></div>
                <div class="cell"><span class="k">@SharedLocalizer["Rev"]</span><span class="v">2.4</span></div>
                <div class="cell"><span class="k">@SharedLocalizer["Sheet"]</span><span class="v">01 / 12</span></div>
            </div>
            <div class="row">
                <div class="cell"><span class="k">@SharedLocalizer["Modules"]</span><span class="v">20</span></div>
                <div class="cell"><span class="k">Items</span><span class="v">1,000+</span></div>
                <div class="cell"><span class="k">@SharedLocalizer["Status"]</span><span class="v"><span class="live-dot"></span>@SharedLocalizer["LIVE"]</span></div>
            </div>
        </div>
    </section>

    <section class="formside" data-study-field data-study-count="22">
        <div class="formcard frame seq">
            <span class="eyebrow eyebrow--signal" style="--i:0">@SharedLocalizer["Access · Sign in"]</span>
            <h2 style="--i:1">@SharedLocalizer["Sign in to continue"]</h2>
            <p class="sub" style="--i:2">@SharedLocalizer["Pick up your prep where you left off."]</p>

            <form method="post" style="--i:3">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="All"></div>

                <label class="field">
                    <span class="field__label">@SharedLocalizer["Email"] <span class="idx">01</span></span>
                    <span class="field__wrap">
                        <input asp-for="Input.Email" class="field__input" placeholder="you@firm.ca" autocomplete="email" />
                    </span>
                    <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                </label>

                <label class="field">
                    <span class="field__label">@SharedLocalizer["Password"] <span class="idx">02</span></span>
                    <span class="field__wrap">
                        <input asp-for="Input.Password" type="password" class="field__input" placeholder="••••••••" autocomplete="current-password" />
                    </span>
                    <span asp-validation-for="Input.Password" class="field-validation-error"></span>
                </label>

                <div class="row-between">
                    <label class="check"><input asp-for="Input.RememberMe" /><span class="box"></span> @SharedLocalizer["Keep me signed in"]</label>
                    <a class="link" asp-page="/Account/ForgotPassword">@SharedLocalizer["Reset password"]</a>
                </div>

                <button class="btn btn--primary btn--block btn--lg" type="submit">
                    @SharedLocalizer["Sign in"] <span class="arrow">&rarr;</span>
                </button>

                <div class="divider mydivider">@SharedLocalizer["Or"]</div>

                <button class="btn btn--ghost btn--block provider gbtn" type="submit" asp-page-handler="GoogleLogin" asp-route-returnUrl="@Model.ReturnUrl">
                    <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.6l6.7-6.7C35.6 2.4 30.2 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.2 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.6c0-1.6-.1-2.8-.4-4.1H24v7.8h12.5c-.3 2.1-1.6 5.2-4.6 7.3l7.1 5.5c4.3-3.9 6.8-9.7 6.8-16.5z"/><path fill="#FBBC05" d="M10.5 28.3c-.5-1.4-.8-2.9-.8-4.3s.3-3 .7-4.3l-7.9-6.1C.9 16.6 0 20.2 0 24s.9 7.4 2.6 10.5l7.9-6.2z"/><path fill="#34A853" d="M24 48c6.2 0 11.4-2 15.2-5.6l-7.1-5.5c-2 1.4-4.6 2.3-8.1 2.3-6.3 0-11.6-3.7-13.5-9.1l-7.9 6.2C6.5 42.6 14.6 48 24 48z"/></svg>
                    @SharedLocalizer["Continue with Google"]
                </button>
            </form>

            <p class="foot">@SharedLocalizer["New here?"] <a asp-page="/Account/Register">@SharedLocalizer["Create an account"]</a></p>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
