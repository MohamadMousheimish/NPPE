@page
@model NPPE.Web.Pages.Account.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = SharedLocalizer["Password updated"].Value;
    Layout = "_AuthLayout";
}

<main class="auth">
    <section class="brand panel--dark reg">
        <span class="reg-mark tl"></span><span class="reg-mark tr"></span>
        <span class="reg-mark bl"></span><span class="reg-mark br"></span>
        <div class="brand__grid grid-bg--dark"></div>

        <svg class="gauge" viewBox="0 0 128 128" aria-hidden="true">
            <circle cx="64" cy="64" r="60" stroke="var(--line-dark)" stroke-width="1"></circle>
            <circle cx="64" cy="64" r="52" stroke="var(--line-dark)" stroke-width="6" stroke-dasharray="1 7.6"></circle>
            <circle class="arc" cx="64" cy="64" r="44"></circle>
            <line x1="64" y1="18" x2="64" y2="26" stroke="var(--slate-2)" stroke-width="1"></line>
            <line x1="64" y1="102" x2="64" y2="110" stroke="var(--slate-2)" stroke-width="1"></line>
            <text class="lbl" x="64" y="63">NPPE</text>
            <text class="sub" x="64" y="76">DONE</text>
        </svg>

        <div class="wordmark">
            <span class="mark">N</span>
            <div class="stack"><b>NPPE&nbsp;Prep</b><span>@SharedLocalizer["Exam Preparation"]</span></div>
        </div>

        <div class="hero">
            <span class="eyebrow eyebrow--signal">@SharedLocalizer["Account recovery"]</span>
            <h1>@SharedLocalizer["You're all"] <em>@SharedLocalizer["set."]</em></h1>
            <p>@SharedLocalizer["Your password is updated. Sign in and pick your prep back up."]</p>
        </div>

        <div class="titleblock">
            <div class="row">
                <div class="cell"><span class="k">@SharedLocalizer["Process"]</span><span class="v">RESET</span></div>
                <div class="cell"><span class="k">@SharedLocalizer["Result"]</span><span class="v">@SharedLocalizer["SUCCESS"]</span></div>
                <div class="cell"><span class="k">@SharedLocalizer["Status"]</span><span class="v"><span class="live-dot"></span>@SharedLocalizer["CLOSED"]</span></div>
            </div>
            <div class="row">
                <div class="cell"><span class="k">@SharedLocalizer["Sessions"]</span><span class="v">@SharedLocalizer["CLEARED"]</span></div>
                <div class="cell"><span class="k">@SharedLocalizer["Progress"]</span><span class="v">@SharedLocalizer["INTACT"]</span></div>
                <div class="cell"><span class="k">@SharedLocalizer["Next"]</span><span class="v">SIGN IN</span></div>
            </div>
        </div>
    </section>

    <section class="formside" data-study-field data-study-count="22">
        <div class="formcard frame seq tc">
            <span class="icon-badge icon-badge--lg icon-badge--pass" style="--i:0">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12.5l4.5 4.5L19 7"/></svg>
            </span>
            <h2 style="--i:1">@SharedLocalizer["Password updated"]</h2>
            <p class="sub" style="--i:2">@SharedLocalizer["You can now sign in with your new password."]</p>
            <a class="btn btn--primary btn--block btn--lg" asp-page="/Account/Login" style="--i:3">@SharedLocalizer["Sign in"] <span class="arrow">&rarr;</span></a>
        </div>
    </section>
</main>
