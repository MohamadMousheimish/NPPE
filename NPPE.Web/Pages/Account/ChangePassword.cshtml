@page
@model NPPE.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = SharedLocalizer["Change password"].Value;
}

<div class="phead" data-reveal>
    <div>
        <span class="eyebrow eyebrow--signal">@SharedLocalizer["Security"]</span>
        <h1>@Html.Raw(SharedLocalizer["Change <em>password</em>"])</h1>
        <p class="sub">@SharedLocalizer["Choose a new password for your account. You'll stay signed in on this device."]</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert--ok" data-reveal>@SharedLocalizer[TempData["SuccessMessage"]!.ToString()!]</div>
}

<div class="form-card" data-reveal style="max-width:480px">
    <form method="post">
        <div asp-validation-summary="All"></div>

        <label class="field">
            <span class="field__label">@SharedLocalizer["Current password"] <span class="idx">01</span></span>
            <span class="field__wrap"><input asp-for="Input.CurrentPassword" type="password" class="field__input" placeholder="••••••••" autocomplete="current-password" /></span>
            <span asp-validation-for="Input.CurrentPassword" class="field-validation-error"></span>
        </label>
        <label class="field">
            <span class="field__label">@SharedLocalizer["New password"] <span class="idx">02</span></span>
            <span class="field__wrap"><input asp-for="Input.NewPassword" type="password" class="field__input" placeholder="••••••••" autocomplete="new-password" /></span>
            <span asp-validation-for="Input.NewPassword" class="field-validation-error"></span>
        </label>
        <label class="field">
            <span class="field__label">@SharedLocalizer["Confirm new password"] <span class="idx">03</span></span>
            <span class="field__wrap"><input asp-for="Input.ConfirmPassword" type="password" class="field__input" placeholder="••••••••" autocomplete="new-password" /></span>
            <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
        </label>

        <div class="note">
            <span class="anno"><strong>@SharedLocalizer["Password spec"]</strong></span>
            <ul>
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4 4 10-10"/></svg> @SharedLocalizer["At least 8 characters"]</li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4 4 10-10"/></svg> @SharedLocalizer["One uppercase letter"]</li>
            </ul>
        </div>

        <div class="form-actions">
            <button class="btn btn--primary" type="submit">@SharedLocalizer["Update password"] <span class="arrow">&rarr;</span></button>
            <a class="btn btn--ghost" asp-page="/Account/Profile">@SharedLocalizer["Cancel"]</a>
        </div>
    </form>
</div>

<a class="backlink" asp-page="/Account/Profile">&larr; @SharedLocalizer["Back to profile"]</a>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
