@page
@model NPPE.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Set a new password";
    Layout = "_AuthLayout";
}

<main class="auth">
    <section class="brand panel--dark reg">
        <span class="reg-mark tl"></span><span class="reg-mark tr"></span>
        <span class="reg-mark bl"></span><span class="reg-mark br"></span>
        <div class="brand__grid grid-bg--dark"></div>

        <svg class="gauge" viewBox="0 0 128 128" aria-hidden="true">
            <circle cx="64" cy="64" r="60" stroke="var(--line-dark)" stroke-width="1"></circle>
            <circle cx="64" cy="64" r="52" stroke="var(--line-dark)" stroke-width="6" stroke-dasharray="1 7.6"></circle>
            <circle class="arc" cx="64" cy="64" r="44"></circle>
            <line x1="64" y1="18" x2="64" y2="26" stroke="var(--slate-2)" stroke-width="1"></line>
            <line x1="64" y1="102" x2="64" y2="110" stroke="var(--slate-2)" stroke-width="1"></line>
            <text class="lbl" x="64" y="63">NPPE</text>
            <text class="sub" x="64" y="76">RESET</text>
        </svg>

        <div class="wordmark">
            <span class="mark">N</span>
            <div class="stack"><b>NPPE&nbsp;Prep</b><span>Exam Preparation</span></div>
        </div>

        <div class="hero">
            <span class="eyebrow eyebrow--signal">Account recovery</span>
            <h1>Set a <em>new key.</em></h1>
            <p>Choose a fresh password and you're back to prepping in seconds.</p>
        </div>

        <div class="titleblock">
            <div class="row">
                <div class="cell"><span class="k">Process</span><span class="v">RESET</span></div>
                <div class="cell"><span class="k">Token</span><span class="v">VERIFIED</span></div>
                <div class="cell"><span class="k">Status</span><span class="v"><span class="live-dot"></span>OPEN</span></div>
            </div>
            <div class="row">
                <div class="cell"><span class="k">Min len</span><span class="v">8 CHARS</span></div>
                <div class="cell"><span class="k">Upper</span><span class="v">REQ.</span></div>
                <div class="cell"><span class="k">Encrypt</span><span class="v">AES-256</span></div>
            </div>
        </div>
    </section>

    <section class="formside" data-study-field data-study-count="22">
        <div class="formcard frame seq">
            <span class="icon-badge" style="--i:0">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M12 15v2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
            </span>
            <h2 style="--i:1">Set a new password</h2>
            <p class="sub" style="--i:2">Make it strong — you'll use it to sign in from now on.</p>

            <form method="post" style="--i:3">
                <input asp-for="Input.UserId" type="hidden" />
                <input asp-for="Input.Code" type="hidden" />
                <div asp-validation-summary="All"></div>

                <label class="field">
                    <span class="field__label">New password <span class="idx">01</span></span>
                    <span class="field__wrap"><input asp-for="Input.Password" type="password" class="field__input" placeholder="••••••••" autocomplete="new-password" /></span>
                    <span asp-validation-for="Input.Password" class="field-validation-error"></span>
                </label>
                <label class="field">
                    <span class="field__label">Confirm password <span class="idx">02</span></span>
                    <span class="field__wrap"><input asp-for="Input.ConfirmPassword" type="password" class="field__input" placeholder="••••••••" autocomplete="new-password" /></span>
                    <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
                </label>

                <div class="note">
                    <span class="anno"><strong>Password spec</strong></span>
                    <ul>
                        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4 4 10-10"/></svg> At least 8 characters</li>
                        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4 4 10-10"/></svg> One uppercase letter</li>
                    </ul>
                </div>

                <button class="btn btn--primary btn--block btn--lg" type="submit">Reset password <span class="arrow">&rarr;</span></button>
            </form>

            <p class="foot">Changed your mind? <a asp-page="/Account/Login">Back to sign in</a></p>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
